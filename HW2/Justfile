# just: Task runner for HW2 Coding Interview Platform

##? set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set shell := ["bash", "-o", "pipefail", "-c"]

ROOT := justfile_directory()
PORT := '8080'
IMAGE := 'hw2'

# Reusable shell snippet to ensure npm is available
NPM_CHECK := '''
if ! command -v npm >/dev/null 2>&1; then
  echo "[error] npm not found. Install Node.js 20+ (e.g., 'brew install node@20' or nvm)." >&2
  exit 127
fi
'''

# Common bash headers
BASH_HEADER := '''
#!/usr/bin/env bash
set -euo pipefail
'''

BASH_HEADER_WITH_NPM := '''
#!/usr/bin/env bash
set -euo pipefail
''' + NPM_CHECK + '''
'''

default: help

help:
  @echo "Available recipes:"
  @echo "  install          - Install root dev deps (concurrently)"
  @echo "  bootstrap        - Install client/server deps if present"
  @echo "  dev              - Run client and server concurrently"
  @echo "  test             - Run server tests (Vitest)"
  @echo "  build            - Build client (Vite)"
  @echo "  stage            - Copy client/dist to server/public"
  @echo "  smoke            - Run basic repo smoke checks"
  @echo "  docker-build     - Build Docker image (IMAGE=hw2 by default)"
  @echo "  docker-run       - Run Docker image on port 8080 (override PORT)"
  @echo "  doctor           - Check prerequisites (node, npm, docker)"

# Install root dev dependencies (concurrently, wait-on)
install:
  {{BASH_HEADER_WITH_NPM}}
  npm install

# Install client and server dependencies if folders exist
bootstrap:
  {{BASH_HEADER_WITH_NPM}}
  bash scripts/bootstrap.sh

# Run both client and server concurrently
dev:
  npm run dev

# Run server integration tests
test:
  npm --prefix server test

# Build client assets
build:
  npm --prefix client run build

# Stage built client into server/public for static serve
stage:
  mkdir -p server/public
  cp -r client/dist/* server/public/ || true

# Quick smoke checks
smoke:
  bash scripts/tests/smoke.sh

# Check environment prerequisites
doctor:
  {{BASH_HEADER}}
  printf "node: "; if command -v node >/dev/null 2>&1; then node -v; else echo "missing"; fi
  printf "npm:  "; if command -v npm  >/dev/null 2>&1; then npm  -v; else echo "missing"; fi
  printf "docker: "; if command -v docker >/dev/null 2>&1; then docker -v; else echo "missing (optional)"; fi

# Build docker image
docker-build IMAGE='hw2':
  docker build -t {{IMAGE}} .

# Run docker image
docker-run IMAGE='hw2' PORT='8080':
  docker run --rm -p {{PORT}}:8080 {{IMAGE}}
